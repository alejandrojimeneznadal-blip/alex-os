# Copia este fichero como .env y rellénalo. El .env nunca se sube a ningún repositorio.

# Base de datos PostgreSQL (obligatoria)
DATABASE_URL=postgres://os:os@localhost:5448/os

# Tu primera cuenta (admin). Solo se leen la primera vez, con la base de datos vacía;
# después el usuario y la contraseña se cambian desde el propio panel.
AUTH_USER=tu_usuario
AUTH_PASS=cambia-esta-contraseña
OWNER_NAME=Tu nombre
OWNER_CONTEXT=

# Firma las sesiones y cifra la clave privada del banco. Pon una cadena larga y aleatoria
# (por ejemplo, la salida de: openssl rand -hex 32) y no la cambies después:
# si cambia, hay que volver a pegar la clave del banco en Configuración → Bancos.
SESSION_SECRET=

PORT=3200

# Opcionales: métricas automáticas de tus vídeos publicados
YOUTUBE_API_KEY=
APIFY_TOKEN=
